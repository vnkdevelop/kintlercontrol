KINTLER_CREDENTIALS=[]
KINTLER_URL=https://relay.example.com
KINTLER_DATABASE=data/kintler.sqlite3
KINTLER_HOST=0.0.0.0
KINTLER_PORT=7443
KINTLER_ALLOW_LOCAL_HTTP=0
KINTLER_TRUSTED_PROXIES=
KINTLER_IMAGE=ghcr.io/vnkdevelop/kintlercontrol:1.2.0
KINTLER_TLS_CERT=/etc/letsencrypt/live/relay.example.com/fullchain.pem
KINTLER_TLS_KEY=/etc/letsencrypt/live/relay.example.com/privkey.pem
KINTLER_CONTROLLER_ID=
KINTLER_CONTROLLER_SECRET=
KINTLER_CONTROLLER_PRIVATE_KEY=
KINTLER_AGENT_ID=
KINTLER_AGENT_SECRET=
KINTLER_AGENT_PRIVATE_KEY=
KINTLER_AGENT_TOOLS=sysinfo,ps,upload,download
KINTLER_NODE_NAME=
KINTLER_WORKSPACE=workspace
KINTLER_CA_FILE=
